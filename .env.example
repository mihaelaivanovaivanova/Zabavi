# BOX NOW Partner API credentials. Issued by BOX NOW only after partner
# registration (integrationsupport@boxnow.bg) — never hardcode real values.
# Leave unset in development: the checkout falls back to BoxNowStubProvider
# (demo shipment creation) whenever any of these is missing.
BOXNOW_API_URL=
BOXNOW_OAUTH_CLIENT_ID=
BOXNOW_OAUTH_CLIENT_SECRET=
# Your warehouse's location ID, from GET /api/v1/origins.
BOXNOW_ORIGIN_LOCATION_ID=
BOXNOW_ORIGIN_CONTACT_NAME=
BOXNOW_ORIGIN_CONTACT_EMAIL=
BOXNOW_ORIGIN_CONTACT_NUMBER=
# Only needed if your account has access to multiple partners (X-PartnerID header).
BOXNOW_PARTNER_ID=
# Shared secret for the inbound parcel-tracking webhook (api/webhooks/boxnow).
# BOX NOW configures the webhook URL together with you and doesn't mandate a
# fixed signature scheme — agree on this value with them, then send it as
# `Authorization: Bearer <value>` on their end. Leave unset to disable the
# webhook (returns 503) rather than accept unauthenticated requests.
BOXNOW_WEBHOOK_SECRET=

# iCard IPG API credentials. Exchanged with iCard only after integration —
# both sides generate an RSA key pair and exchange public keys; never
# hardcode real values. Leave unset in development: the checkout falls
# back to ICardStubProvider (demo payment, no embedded widget) whenever
# any of these is missing.
ICARD_API_URL=https://ipay.bg/paymentpage
ICARD_ORIGINATOR=
ICARD_MID=
ICARD_MID_NAME=
# Our RSA private key (PEM), used to sign outgoing requests to iCard.
ICARD_PRIVATE_KEY=
# iCard's RSA public key (PEM), used to verify responses/notifications from iCard.
ICARD_IPG_PUBLIC_KEY=
# Identifies which exchanged key pair signed the request, if more than one.
ICARD_KEY_INDEX=1
ICARD_IPG_VERSION=3.3
ICARD_LANGUAGE=BG

# Real order persistence (Postgres, e.g. a Railway Postgres plugin). Leave
# unset in development: the app falls back to an in-memory order store that
# resets on every restart.
DATABASE_URL=

# Admin panel (/admin) credentials. All three are required — admin login is
# disabled entirely until every one of them is set; there is no default
# username/password. Generate ADMIN_SESSION_SECRET with e.g.
# `openssl rand -base64 32`.
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Encrypts secrets (iCard RSA keys, BOX NOW/Speedy credentials) saved from
# /admin/settings before they're written to the database. Required once any
# of those are saved through the admin panel — generate with e.g.
# `openssl rand -base64 32`. Changing this key makes previously saved
# secrets undecryptable, so treat it like any other production credential.
SETTINGS_ENCRYPTION_KEY=

# Speedy Web API credentials. Leave unset (or SPEEDY_ENABLED unset/false)
# in development: the checkout falls back to CourierStubProvider (demo
# shipment creation) until every one of these is set and enabled.
SPEEDY_ENABLED=
SPEEDY_API_URL=https://api.speedy.bg/v1
SPEEDY_USERNAME=
SPEEDY_PASSWORD=
# The Speedy office this account drops parcels off at (sender.dropoff).
SPEEDY_DROPOFF_OFFICE_ID=
# Account-specific — verify in this account's own Speedy profile. Defaults
# to Speedy's commonly used standard courier service id.
SPEEDY_SERVICE_ID=505

# Real order emails (confirmation/admin-notification/cancelled/delivered/
# invoice — see infrastructure/email/orderEmails.ts) send through the same
# RESEND_API_KEY/RESEND_FROM_EMAIL as everything else in emailProvider.ts;
# nothing extra to set for the customer-facing ones. This is only for the
# admin-notification email: a comma-separated list of addresses to notify on
# every paid/confirmed order. Leave unset to skip it entirely.
ORDER_NOTIFICATION_EMAILS=

# Admin-configurable via /admin/settings/shipping; this is only the env
# fallback used before that's ever been saved. Flat cash-on-delivery
# surcharge, folded into checkout totals — see checkoutSettingsService.ts.
COD_FEE_EUR=0.5

# Meta Pixel ID, loaded client-side only after the visitor grants
# "marketing" cookie consent (see CookieConsentContext/MetaPixelLoader) —
# same model as smisul.bg's analytics.ts. Leave unset to keep the pixel off;
# there is no hardcoded fallback ID, unlike smisul.bg's own real pixel.
NEXT_PUBLIC_META_PIXEL_ID=
